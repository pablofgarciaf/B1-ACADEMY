NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only secrets. Put real values in .env.local and Vercel Secrets.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NVIDIA_API_KEY=
# Modelo del examen (NVIDIA primero; si falla, Gemini)
NVIDIA_EXAM_MODEL=nvidia/nemotron-3-super-120b-a12b
N8N_WEBHOOK_SECRET=
CERTIFICATE_SIGNING_SECRET=

# Voz y examen de certificación (texto con Gemini, capa gratuita)
GEMINI_API_KEY=
EXAM_MODEL=gemini-2.5-flash

# Origen público y datos legales: completar antes de activar captación en producción.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_RUC=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_GTM_ID=
# Secreto exclusivo del servidor; conservar estable en el despliegue.
TTS_SIGNING_SECRET=
# Opcional: corte ISO estable posterior al incluido en esta versión para cuentas antiguas.
AUTH_POLICY_EPOCH=
# Solo en un proxy propio que reemplace X-Forwarded-For (Vercel se reconoce automáticamente).
TRUST_PROXY_HEADERS=false
