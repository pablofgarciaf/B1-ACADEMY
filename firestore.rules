rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function admin() { return signedIn() && profile().role in ['super', 'admin']; }

    match /usuarios/{uid} {
      allow read: if owns(uid) || admin();
      allow create: if owns(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'estudiante'
        && request.resource.data.status == 'active';
      allow update: if admin() || (owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'passwordChanged', 'simuladorXP', 'simuladorLevel', 'completedMissions',
          'moduleProgress', 'sandboxHoursUsed', 'avatar', 'bio', 'company', 'updatedAt'
        ]));
      allow delete: if admin();

      match /sociedades/{sociedadId}/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    // Writes are validated and committed with Firebase Admin by /api/sap/company.
    match /sapCompanies/{uid} {
      allow read: if owns(uid) || (signedIn() && profile().role in ['teacher', 'docente']);
      allow write: if false;
      match /{document=**} {
        allow read: if owns(uid) || (signedIn() && profile().role in ['teacher', 'docente']);
        allow write: if false;
      }
    }
    match /courses/{courseId} { allow read: if true; allow write: if admin(); }
    match /evaluations/{evaluationId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow write: if false; // Solo Firebase Admin desde el servidor.
    }
    match /job_listings/{jobId} { allow read: if true; allow write: if admin(); }
    match /job_applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid;
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || admin());
      allow update, delete: if admin();
    }
  }
}
